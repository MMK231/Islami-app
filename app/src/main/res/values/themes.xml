<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.IslamiApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryVariant">@color/light_gold</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/dark_gold</item>
        <item name="colorSecondaryVariant">@color/dark_gray</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
    <style name="tool_bar_style">
        <item name="android:textSize">32sp</item>
        <item name="android:text">Islami</item>
       <item name="android:layout_gravity">center</item>
    </style>
    <style name="suras_style">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">30sp</item>
            <item name="android:fontFamily">@font/janna_lt_regular</item>
    </style>

</resources>